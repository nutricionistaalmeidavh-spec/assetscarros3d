    "chevrolet-corsa": {
      "paint": "#406F87",
      "rules": [
        {
          "match": "^(Bootok|Chassis003|Doorrfok|Mala007|Part)\\w*Mtl$",
          "role": "paint"
        },
        {
          "match": "^Tire1Mtl$",
          "color": "#171C21",
          "roughness": 0.95,
          "metallic": 0
        },
        {
          "match": "^(Wheel002|Disc|Hub|Caliper|Cupper)\\w*Mtl$",
          "color": "#9CA9AE",
          "roughness": 0.5,
          "metallic": 0.28
        },
        {
          "match": "^Interior\\w*Mtl$",
          "color": "#293238",
          "roughness": 0.9,
          "metallic": 0
        },
        {
          "match": "^Meshpart\\w*Mtl$",
          "color": "#737E82",
          "roughness": 0.74,
          "metallic": 0.05
        }
      ],
      "fallback": {
        "color": "#9AA5A7",
        "roughness": 0.7,
        "metallic": 0
      }
    },
    "fiat-palio": {
      "paint": "#667B93",
      "rules": [
        {
          "match": ".*",
          "role": "paint",
          "when": "NEON_GREEN",
          "metallic": 0.15,
          "roughness": 0.53
